# ── Axula — Variables de entorno
# Copiar este archivo como .env y completar los valores reales
# NUNCA subir .env al repositorio

# Obligatorias
SECRET_KEY=genera-una-clave-con-python3-c-import-secrets-print-secrets.token_hex-32

# Rutas de datos (en Render apuntan al disco persistente /data)
DATABASE_PATH=database.db
FOTOS_DIR=static/fotos
LOG_DIR=logs

# Seguridad
SESSION_COOKIE_SECURE=false   # true en producción con HTTPS
FLASK_DEBUG=0

# IA — Groq (obtener en console.groq.com)
GROQ_API_KEY=sk-...

# Email (opcional — para bienvenida de usuarios)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=correo@escuela.edu
# SMTP_PASS=app-password
